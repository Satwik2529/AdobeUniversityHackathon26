{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NLP Query Intelligence — website-profile.json",
  "type": "object",
  "required": ["profiler_version", "snapshot_hash", "domain_type", "entities"],
  "properties": {
    "profiler_version": { "type": "string" },
    "snapshot_hash": { "type": "string" },
    "site": { "type": ["string", "null"] },
    "pages_considered": { "type": "integer", "minimum": 0 },
    "domain_type": { "enum": ["shopping", "software", "content", "corporate", "generic"] },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text", "page_count", "confidence"],
        "properties": {
          "text": { "type": "string" },
          "page_count": { "type": "integer" },
          "confidence": { "enum": ["high", "low"] }
        }
      }
    },
    "categories": { "type": "array", "items": { "type": "string" } },
    "attributes": { "type": "array", "items": { "type": "string" } },
    "audiences": { "type": "array", "items": { "type": "string" } },
    "use_cases": { "type": "array", "items": { "type": "string" } },
    "price_signals": {
      "type": ["object", "null"],
      "properties": {
        "min": { "type": "number" },
        "max": { "type": "number" },
        "sample_size": { "type": "integer" },
        "currency": { "type": ["string", "null"] }
      }
    }
  }
}
